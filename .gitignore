# ===========================================
# Root .gitignore
# ===========================================

# Reference codebase (not our code)
MiroFish-main/

# Spec / design docs (local only)
kiro_climate_mirofish_codespec_compact.md

# IDE / Editor
.kiro/
.vscode/
.idea/
*.swp
*.swo
*~

# Environment secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
env/
.venv/
*.egg-info/
dist/
build/

# Node
node_modules/
.next/
out/

# Testing
**/tests/
**/test/
**/test_*.py
**/conftest.py
**/*.test.*
**/*.spec.*
.coverage
htmlcov/
.pytest_cache/
coverage/
jest.config.*
pytest.ini
tox.ini

# Database
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store
Thumbs.db
._*

# Logs
*.log

# Build / cache
*.pyc
*.bak
*.tmp
*.cache
.cache/
.mypy_cache/
.ruff_cache/

# Lock files (keep package-lock.json)
uv.lock
poetry.lock
Pipfile.lock
