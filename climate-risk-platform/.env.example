# =============================================================
# Climate Risk Platform — Environment Variables
# =============================================================
# Copy to climate-risk-platform/backend/.env and fill in your keys.

# --- LLM API Key (pick ONE — enables smart event parsing + per-agent reasoning) ---
# Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI (alternative)
# OPENAI_API_KEY=your-openai-api-key-here

# Custom LLM endpoint (for local models, Azure, etc.)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3

# --- Database (defaults to SQLite — no setup needed) ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/climate_risk

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000

# --- Optional ---
# MAPBOX_TOKEN=your-mapbox-token-here
# REDIS_URL=redis://localhost:6379
